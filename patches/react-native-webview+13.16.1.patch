+/**
+ * Local patch: lets the host app route the next created WebView into an
+ * AndroidX WebKit profile (multi-account isolation). The profile name is
+ * set by the app's WebViewProfiles expo module BEFORE the WebView
+ * component mounts; the binding must happen before the first navigation,
+ * which is why it lives at WebView creation time. A null name means the
+ * default profile (normal behavior).
+ */
+object RNCWebViewProfileRegistry {
+    private const val TAG = "RNCWebViewProfiles"
+
+    @Volatile
+    @JvmStatic
+    var pendingProfileName: String? = null
+
+    @JvmStatic
+    fun bindPendingProfile(webView: WebView) {
+        val profileName = pendingProfileName ?: return
+        try {
+            if (WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE)) {
+                ProfileStore.getInstance().getOrCreateProfile(profileName)
+                WebViewCompat.setProfile(webView, profileName)
+                Log.i(TAG, "Bound new WebView to an isolated profile")
+            } else {
+                Log.w(TAG, "MULTI_PROFILE unsupported; WebView uses the default profile")
+            }
+        } catch (error: Throwable) {
+            Log.e(TAG, "Failed to bind WebView profile", error)
+        }
+    }
+}
